{
  "name": "nuxt-yup",
  "version": "2.4.2",
  "description": "yup implementation for nuxt",
  "repository": "DarlanPrado/nuxt-yup",
  "license": "MIT",
  "type": "module",
  "keywords": [
    "nuxt",
    "yup",
    "nuxt-module",
    "nuxt3",
    "nuxt4"
  ],
  "homepage": "https://github.com/DarlanPrado/nuxt-yup#readme",
  "bugs": {
    "url": "https://github.com/DarlanPrado/nuxt-yup/issues"
  },
  "contributors": [
    {
      "name": "Darlan José Batista do Prado",
      "email": "darlanprado.contact@gmail.com",
      "url": "https://github.com/DarlanPrado"
    }
  ],
  "exports": {
    ".": {
      "types": "./dist/types.d.mts",
      "import": "./dist/module.mjs",
      "require": "./dist/module.mjs",
      "default": "./dist/module.mjs"
    }
  },
  "main": "./dist/module.mjs",
  "types": "./dist/types.d.mts",
  "files": [
    "dist"
  ],
  "scripts": {
    "prepack": "nuxt-module-build build",
    "dev": "nuxi dev playground",
    "dev:build": "nuxi build playground",
    "dev:prepare": "nuxt-module-build build --stub && nuxt-module-build prepare && nuxi prepare playground",
    "release": "npm run lint && npm run test && npm run test:types && npm run prepack && changelogen --release && npm publish && git push --follow-tags",
    "lint": "eslint .",
    "test": "cross-env NODE_OPTIONS=--no-deprecation vitest run",
    "test:watch": "cross-env NODE_OPTIONS=--no-deprecation vitest watch",
    "test:types": "cd playground && vue-tsc --noEmit"
  },
  "dependencies": {
    "@types/yup": "^0.32.0",
    "yup": "^1.7.1"
  },
  "devDependencies": {
    "@nuxt/devtools": "^2.7.0",
    "@nuxt/eslint-config": "^1.10.0",
    "@nuxt/kit": "^4.2.0",
    "@nuxt/module-builder": "^1.0.2",
    "@nuxt/schema": "^4.2.0",
    "@nuxt/test-utils": "^3.20.1",
    "@types/node": "latest",
    "@typescript-eslint/eslint-plugin": "8.7.0",
    "@typescript-eslint/parser": "8.7.0",
    "baseline-browser-mapping": "^2.10.0",
    "changelogen": "^0.6.2",
    "cross-env": "^10.1.0",
    "eslint": "^9.39.1",
    "nuxt": "^4.2.0",
    "typescript": "latest",
    "vitest": "^3.2.4",
    "vue-tsc": "^3.1.3"
  }
}
